# ===========================================
# Sanaei VPN Bot - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# === Bot Configuration ===
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_IDS=123456789
DOMAIN=https://your-domain.com

# === Database ===
DB_NAME=sanaei_bot
DB_USER=sanaei
DB_PASS=sanaei_secret
DB_PORT=5432
DATABASE_URL=postgresql://sanaei:sanaei_secret@postgres:5432/sanaei_bot

# === Redis ===
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# === Server Ports ===
BOT_PORT=3000
MINIAPP_PORT=8080
ADMIN_PORT=8081
WEBHOOK_PATH=/webhook

# === Sanaei Panel ===
# Include the full base path if your panel uses a custom URI path
# Example: https://your-domain:2053/randomBasePath
PANEL_URL=https://your-panel:2053/yourBasePath
# API Key (recommended for v3.x+): Panel → Settings → Security → API Token
PANEL_API_KEY=
# Legacy login (used only if PANEL_API_KEY is empty)
PANEL_USERNAME=admin
PANEL_PASSWORD=admin

# === Payment Gateways ===
ZARINPAL_MERCHANT_ID=
AQAYEPARDAKHT_PIN=
IRANPAY_API_KEY=
NOWPAYMENTS_API_KEY=
PLISIO_API_KEY=
TRONADO_API_KEY=
TRONADO_WALLET=
CARD_NUMBER=6037-9911-2233-4455
CARD_HOLDER=

# === JWT ===
JWT_SECRET=change_this_to_a_random_string

# === Mini App ===
MINIAPP_URL=https://your-domain.com/app

# === Channel (mandatory join) ===
CHANNEL_ID=@your_channel
CHANNEL_ENABLED=true

# === Feature Toggles ===
TRIAL_ENABLED=true
TRIAL_DAYS=1
TRIAL_VOLUME_GB=1
REFERRAL_ENABLED=true
REFERRAL_REWARD=10000
LOTTERY_ENABLED=true
PHONE_VERIFY_ENABLED=false
