# ===========================================
# Sanaei VPN Bot - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# === Bot Configuration ===
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_IDS=123456789
DOMAIN=https://your-domain.com

# === Database ===
DB_NAME=sanaei_bot
DB_USER=sanaei
DB_PASS=change_me_strong_password
DB_PORT=5432
DATABASE_URL=postgresql://sanaei:change_me_strong_password@postgres:5432/sanaei_bot

# === Redis ===
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# === Server Ports ===
BOT_PORT=3000
MINIAPP_PORT=8080
ADMIN_PORT=8081
WEBHOOK_PATH=/webhook
# Optional Telegram webhook secret token (X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=
# Set to true if you don't have HTTPS/Caddy (uses long-polling instead of webhook)
USE_POLLING=false

# === Sanaei Panel ===
# Include the full base path if your panel uses a custom URI path
# Example: https://your-domain:2053/randomBasePath
PANEL_URL=https://your-panel:2053/yourBasePath
# API Key (recommended for v3.x+): Panel → Settings → Security → API Token
PANEL_API_KEY=
# Legacy login (used only if PANEL_API_KEY is empty)
PANEL_USERNAME=admin
PANEL_PASSWORD=admin
# Subscription link path (default: /sub)
PANEL_SUB_PATH=/sub

# === Payment Gateways ===
ZARINPAL_MERCHANT_ID=
AQAYEPARDAKHT_PIN=
IRANPAY_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PLISIO_API_KEY=
TRONADO_API_KEY=
TRONADO_WALLET=
CARD_NUMBER=
CARD_HOLDER=
# Approx Tomans per 1 USD (crypto gateways)
USD_TOMAN_RATE=90000

# === JWT / Admin ===
# MUST be a long random string (min 16 chars)
JWT_SECRET=change_this_to_a_long_random_string_please
ADMIN_USERNAME=admin
# Set a strong password; stored hashed in DB after first login
ADMIN_PASSWORD=change_me_admin_password

# === Mini App / Admin frontends ===
MINIAPP_URL=https://your-domain.com/app
ADMIN_URL=https://your-domain.com/admin
# Used at Docker build time for Vite
VITE_API_URL=/api
VITE_ADMIN_API_URL=/api/admin
# Comma-separated origins, or * 
CORS_ORIGINS=

# === Channel (mandatory join) ===
CHANNEL_ID=@your_channel
CHANNEL_ENABLED=false

# === Feature Toggles ===
TRIAL_ENABLED=true
TRIAL_DAYS=1
TRIAL_VOLUME_GB=1
REFERRAL_ENABLED=true
REFERRAL_REWARD=10000
REFERRAL_CASHBACK_PERCENT=0
LOTTERY_ENABLED=false
PHONE_VERIFY_ENABLED=false
# Tomans per extra GB for volume top-up
VOLUME_GB_PRICE=5000
