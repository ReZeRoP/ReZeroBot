# Force LF line endings for shell scripts (critical for Linux deployment)
*.sh text eol=lf

# Source files
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.conf text eol=lf

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
