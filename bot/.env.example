# === Bot Configuration ===
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_IDS=123456789,987654321
DOMAIN=https://your-domain.com

# === Database ===
DATABASE_URL=postgresql://sanaei:sanaei_secret@localhost:5432/sanaei_bot
DB_NAME=sanaei_bot
DB_USER=sanaei
DB_PASS=sanaei_secret
DB_PORT=5432

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Server ===
BOT_PORT=3000
WEBHOOK_PATH=/webhook

# === Sanaei Panel ===
PANEL_URL=http://your-panel:2053
PANEL_USERNAME=admin
PANEL_PASSWORD=admin

# === Payment Gateways ===
# Zarinpal
ZARINPAL_MERCHANT_ID=
# Aqayepardakht
AQAYEPARDAKHT_PIN=
# IranPay
IRANPAY_API_KEY=
# NowPayments
NOWPAYMENTS_API_KEY=
# Plisio
PLISIO_API_KEY=
# Tronado
TRONADO_API_KEY=
TRONADO_WALLET=
# Card to Card
CARD_NUMBER=6037-9911-2233-4455
CARD_HOLDER=John Doe

# === JWT ===
JWT_SECRET=your_jwt_secret_change_this

# === Mini App ===
MINIAPP_URL=https://your-domain.com/app

# === Channel (mandatory join) ===
CHANNEL_ID=@your_channel
CHANNEL_ENABLED=true

# === Feature Toggles ===
TRIAL_ENABLED=true
TRIAL_DAYS=1
TRIAL_VOLUME_GB=1
REFERRAL_ENABLED=true
REFERRAL_REWARD=10000
LOTTERY_ENABLED=true
PHONE_VERIFY_ENABLED=false
